# PostgreSQL (used directly by docker-compose and by Prisma via DATABASE_URL)
POSTGRES_USER=wcag_auditor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wcag_auditor
POSTGRES_PORT=5432

# Prisma / backend
DATABASE_URL="postgresql://wcag_auditor:change-me@localhost:5432/wcag_auditor?schema=public"
BACKEND_PORT=3000

# Shared token required on every POST/PUT/PATCH/DELETE route (header: Authorization: Bearer <token>).
# GET routes stay public. This is a minimal guard, not user authentication (see section 5 of CLAUDE.md).
# - Replace "change-me" with a long random value before any public deployment, e.g. in PowerShell:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# - Empty: mutations stay OPEN in development (startup warning) and are REFUSED when NODE_ENV=production.
# - Never put this token in a VITE_* variable: those are baked into the public JavaScript bundle.
#   Users type it in the "Access token" field of the scan form instead (kept in sessionStorage).
MUTATION_API_TOKEN=change-me

# Scan engine
SCAN_TIMEOUT_MS=30000

# CORS: comma-separated origins allowed to call the API (the frontend's own origin)
CORS_ORIGIN=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:3000
FRONTEND_PORT=5173
